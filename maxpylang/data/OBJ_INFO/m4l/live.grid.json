  "doc": {
    "digest": "A UI grid of steps, with constraints and directions",
    "description": "live.grid is a user interfaces object designed for use with the chucker~ object. It provides a display grid of steps, constraints for transposition, and playback direction for use in controlling the chucker~ object.",
    "inlets": [
      {"id": "0", "type": "INLET_TYPE", "digest": "Message in"},
      {"id": "1", "type": "INLET_TYPE", "digest": "Sync Messages"}
    ],
    "outlets": [
      {"id": "0", "type": "list", "digest": "Current Step Value (y value, direction)"},
      {"id": "1", "type": "list", "digest": "Steps Values"},
      {"id": "2", "type": "list", "digest": "Directions Values"},
      {"id": "3", "type": "list", "digest": "Mouse Over Information"},
      {"id": "4", "type": "list", "digest": "dumpout"},
      {"id": "5", "type": "anything", "digest": "Synchronisation Messages (if Linked)"}
    ],
    "methods": [
      {"name": "int", "digest": "Set, display, and output the current step", "args": [{"name": "step-index", "optional": "0", "type": "int"}]},
      {"name": "list", "digest": "Function depends on the direction or matrixmode attributes", "args": [{"name": "input-list", "optional": "0", "type": "list"}]},
      {"name": "clear", "digest": "Deselect all currently set rows and columns"},
      {"name": "constraint", "digest": "Set the constraint for a step", "args": [{"name": "constraint of the step", "optional": "0", "type": "list"}]},
      {"name": "directions", "digest": "Set a step's playback direction", "args": [{"name": "directions", "optional": "0", "type": "list"}]},
      {"name": "down", "digest": "Decrease all step values"},
      {"name": "freeze", "digest": "Display/hide a frozen step", "args": [{"name": "step-index", "optional": "0", "type": "int"}]},
      {"name": "getcell", "digest": "Report the value of a specified cell", "args": [{"name": "x-index", "optional": "0", "type": "int"}, {"name": "y-index", "optional": "0", "type": "int"}]},
      {"name": "getcolumn", "digest": "Report the values for a specified column", "args": [{"name": "column", "optional": "0", "type": "int"}]},
      {"name": "getconstraint", "digest": "Report the constraint values for a specified column", "args": [{"name": "column", "optional": "0", "type": "int"}]},
      {"name": "getdirections", "digest": "Report the direction for a specified column", "args": [{"name": "column", "optional": "0", "type": "int"}]},
      {"name": "getrow", "digest": "Report the values for a specified row", "args": [{"name": "row", "optional": "0", "type": "int"}]},
      {"name": "init", "digest": "Restore and output the initial values"},
      {"name": "left", "digest": "Left-shift values of all steps"},
      {"name": "linkdump", "digest": "Synchronize a live.grid object to another"},
      {"name": "random", "digest": "Generate new step values or step constraints", "args": [{"name": "type (optional)", "optional": "0", "type": "list"}]},
      {"name": "reset", "digest": "Set the default values or clear constraints", "args": [{"name": "type (optional)", "optional": "0", "type": "list"}]},
      {"name": "right", "digest": "Right-shift all step values"},
      {"name": "set", "digest": "Set and display an output step without causing output", "args": [{"name": "step-index", "optional": "0", "type": "int"}]},
      {"name": "setcell", "digest": "Set the value of the specified cell", "args": [{"name": "x-index", "optional": "0", "type": "int"}, {"name": "y-index", "optional": "0", "type": "int"}, {"name": "value", "optional": "0", "type": "int"}]},
      {"name": "steps", "digest": "Set the values of all the steps at once", "args": [{"name": "step values", "optional": "0", "type": "list"}]},
      {"name": "up", "digest": "Increase all step values"}
    ]
